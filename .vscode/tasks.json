{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Copilot CLI",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}",
        "python",
        "-B",
        "${workspaceFolder}/.vscode/copilot-sandbox/src/start.py",
        "--workspace",
        "${workspaceFolder}",
        "--sandbox-name",
        "copilot-${workspaceFolderBasename}-isolated"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}