{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Copilot CLI",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-File",
        "${workspaceFolder}\\.vscode\\start-copilot-sandbox.ps1",
        "-Workspace",
        "${workspaceFolder}",
        "-SandboxName",
        "copilot-${workspaceFolderBasename}-isolated"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
